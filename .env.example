# ============================================================================
# TalentPact — Variables de entorno (plantilla)
#
# Copia este archivo a `.env` y rellena los valores.  El `.env` real está en
# .gitignore y NUNCA debe subirse al repositorio.
#
#   cp .env.example .env       (Git Bash / macOS / Linux)
#   Copy-Item .env.example .env  (PowerShell)
#
# En producción los mismos valores van en:
#   Netlify → Site settings → Environment variables
# ============================================================================


# ─── ① IA — Evaluación de retos (obligatorio para el demo de IA) ────────────
# Consola: https://console.anthropic.com  →  API Keys
# Usado por: netlify/functions/evaluate-exercise.js, support-chat.js
ANTHROPIC_API_KEY=sk-ant-...
# Opcional. Por defecto: claude-sonnet-4-6
ANTHROPIC_MODEL=claude-sonnet-4-6

# Corrector v2: firma de los recibos de evaluación (HMAC-SHA256). Con ella,
# save-evaluation distingue una nota puesta por el corrector de una enviada a
# mano desde el navegador. Genera una con:  openssl rand -hex 32
EVAL_SIGNING_SECRET=
# Modo crudo del corrector (el cliente envía sus propios prompts). Solo para el
# banco de pruebas y la demo de la Entrega 2; NUNCA en producción.
# EVAL_ALLOW_RAW_PROMPTS=1


# ─── ② Supabase — Persistencia (obligatorio para guardar y certificar) ──────
# Supabase → Project Settings → API
# Usado por: lib/tp.js (save-profile, save-evaluation, get-progress,
#            issue-credential, anchor-credential)
SUPABASE_URL=https://vqyqedmizxqneniynxqp.supabase.co
# ⚠️ SECRETA — es la service_role key, NO la anon. Solo servidor.
SUPABASE_SERVICE_KEY=eyJ...


# ─── ③ Blockchain — Anclaje de credenciales en Ethereum Sepolia (testnet) ───
# Red: Ethereum Sepolia (chainId 11155111).  Explorador: sepolia.etherscan.io
# El contrato SkillPassRegistry ya desplegado esta en:
#   tfm/tech/build/deployment-sepolia.json
# Guia paso a paso: tfm/tech/SETUP_CHECKLIST.md
# Faucet (solo cuenta de Google, sin comprar cripto):
#   https://cloud.google.com/application/web3/faucet/ethereum/sepolia

# Endpoint RPC de la red. El publico funciona; Alchemy/Infura es mas fiable.
# Opcional: si se omite se usa https://ethereum-sepolia-rpc.publicnode.com
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# ⚠️ SECRETA — clave privada de la wallet emisora (MetaMask → Exportar clave
# privada). Wallet NUEVA y solo de testnet, sin fondos reales.
# Con o sin el prefijo 0x, ambos valen.
ISSUER_PRIVATE_KEY=0x...

# Direccion publica de esa misma wallet. No es secreta; sirve para verificar
# que la clave privada corresponde al emisor del contrato.
ISSUER_ADDRESS=0x...

# Direccion del contrato SkillPassRegistry una vez desplegado.
# La obtienes ejecutando:  npm run deploy:contract
SKILLPASS_CONTRACT_ADDRESS=0x...

# ─── SkillPass v2: credencial firmada y sello por lotes ───────────────────
# ⚠️ SECRETA — clave Ed25519 con la que TalentPact firma los SkillPass (W3C VC).
# Genérala con:  npm run vc:clave   (distinta de ISSUER_PRIVATE_KEY).
# VC_SIGNING_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

# Dominio público (did:web y enlaces de verificación). Por defecto https://talentpact.es
# SITE_URL=https://talentpact.es

# Red del sello por lotes: base-sepolia (pruebas, por defecto) o base (producción).
# SEAL_CHAIN=base-sepolia
# SEAL_RPC=https://sepolia.base.org

# Contrato SkillPassRegistryV2 (un lote al día). Se obtiene con:
#   npm run deploy:contract:v2
# SKILLPASS_V2_CONTRACT_ADDRESS=0x...

# Opcional. Margen (ms) que anchor-batch espera a que la red confirme el lote.
# ANCHOR_WAIT_MS=20000

# COMPATIBILIDAD: despliegues antiguos usaban POLYGON_AMOY_RPC. Se sigue
# leyendo como alternativa a SEPOLIA_RPC, pero la red efectiva es Sepolia
# (definida en CHAIN, en netlify/functions/lib/tp.js y tfm/tech/scripts/lib-env.js).
# POLYGON_AMOY_RPC=

# ─── ④ Stripe — Pagos (desbloqueo de contacto, €49) ─────────────────────────
# Panel: https://dashboard.stripe.com/test/apikeys  (pestana "Modo de prueba")
# Crear la cuenta es gratis y NO pide tarjeta.
#
# MODO DE PRUEBA: con claves sk_test_ no se cobra nada. Tarjeta de prueba:
#   4242 4242 4242 4242 · cualquier fecha futura · cualquier CVC
# Lista completa: https://stripe.com/docs/testing
#
# ⚠️ SECRETA — solo servidor. sk_test_ para pruebas, sk_live_ para cobros reales.
STRIPE_SECRET_KEY=sk_test_...

# Firma del webhook. Sin ella, stripe-webhook rechaza todo: es lo unico que
# impide que alguien simule un cobro con un POST.
#   Produccion:  Stripe → Developers → Webhooks → endpoint →
#                https://<tu-sitio>/.netlify/functions/stripe-webhook
#                Eventos: checkout.session.completed, checkout.session.expired,
#                         checkout.session.async_payment_succeeded/failed
#   Local:       stripe listen --forward-to localhost:8888/.netlify/functions/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Opcional. Precio del desbloqueo en centimos y moneda. Se fija en el SERVIDOR
# a proposito: si viniera del navegador, se podria pagar 1 centimo.
# UNLOCK_PRICE_CENTS=4900
# UNLOCK_CURRENCY=eur
